<guides xmlns="https://www.phpdoc.org/guides"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="https://www.phpdoc.org/guides ../vendor/phpdocumentor/guides-cli/resources/schema/guides.xsd"
        links-are-relative="true"
        default-code-language="php"
>
    <extension class="\T3Docs\Typo3DocsTheme\DependencyInjection\Typo3DocsThemeExtension"
               project-home="{{PROJECT_HOME_URL}}"
               project-repository="{{REPOSITORY_URL}}"
               project-issues="{{ISSUES_URL}}"
               edit-on-github="{{GITHUB_OWNER_AND_REPOSITORY}}"
               edit-on-github-branch="{{DEFAULT_BRANCH}}"
               typo3-core-preferred="{{TYPO3_VERSION}}"
               interlink-shortcode="{{COMPOSER_PACKAGE_NAME}}"
    />
    <project title="{{EXTENSION_TITLE}}"
             version="local"
             copyright="{{COPYRIGHT}}"
    />
</guides>

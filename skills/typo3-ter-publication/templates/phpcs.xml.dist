<?xml version="1.0"?>
<ruleset name="Extension supplemental PHPCS check">
  <description>PSR-12 supplemental check. Run TYPO3 coding-standards PHP-CS-Fixer separately.</description>
  <file>Classes</file>
  <file>Configuration</file>
  <file>Tests</file>
  <arg name="extensions" value="php"/>
  <rule ref="PSR12"/>
</ruleset>

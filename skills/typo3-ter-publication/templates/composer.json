{
  "name": "acme/example-extension",
  "type": "typo3-cms-extension",
  "description": "Example Extension - Demonstrates a TER-ready package",
  "license": "GPL-2.0-or-later",
  "authors": [
    {
      "name": "Example Maintainer",
      "email": "maintainer@example.org",
      "role": "Developer"
    }
  ],
  "homepage": "https://example.org/example-extension",
  "support": {
    "issues": "https://example.org/example-extension/issues",
    "source": "https://example.org/example-extension"
  },
  "require": {
    "php": "^8.2",
    "typo3/cms-core": "^14.3"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.5",
    "phpstan/phpstan": "^2.1",
    "saschaegerer/phpstan-typo3": "^3.1",
    "squizlabs/php_codesniffer": "^4.0",
    "typo3/coding-standards": "^0.9",
    "typo3/testing-framework": "^9.7",
    "typo3/tailor": "^1.0"
  },
  "autoload": {
    "psr-4": {
      "Acme\\ExampleExtension\\": "Classes/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Acme\\ExampleExtension\\Tests\\": "Tests/"
    }
  },
  "config": {
    "allow-plugins": {
      "typo3/class-alias-loader": true,
      "typo3/cms-composer-installers": true
    }
  },
  "extra": {
    "typo3/cms": {
      "extension-key": "example_extension",
      "version": "1.0.0",
      "Package": {
        "providesPackages": {}
      }
    }
  }
}
